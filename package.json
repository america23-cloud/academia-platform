    "express": "^5.3.0",
    "express-handlebars": "^9.0.4",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
